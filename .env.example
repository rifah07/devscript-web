# Which site this deployment is: DEVSCRIPT or PERSONAL (The Misk Journal)
NEXT_PUBLIC_SPACE=DEVSCRIPT
# This site's public URL (dev: 3001 for DevScript, 3002 for Misk)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only. NEVER prefix these with NEXT_PUBLIC_ (that ships them to browsers)
BACKEND_URL=http://localhost:3000
INTERNAL_API_KEY=same-value-as-the-api
